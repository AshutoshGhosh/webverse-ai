# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
# Optional: chat/analysis model (default: gpt-4o). Must support Chat Completions
# streaming + strict structured outputs (e.g. gpt-4o, gpt-4o-mini, gpt-4.1).
OPENAI_MODEL=

# GitHub OAuth app (configured in Supabase Auth → Providers → GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: OAuth scopes requested at sign-in.
# Default (least privilege) reads PUBLIC repos only: "public_repo read:user".
# To analyze PRIVATE repositories, set: GITHUB_OAUTH_SCOPES=repo read:user
GITHUB_OAUTH_SCOPES=
